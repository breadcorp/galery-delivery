# Inside server {}, before any general PHP regex location.
# The server root is /var/www/site. Change all paths for your host.
location = /downloads { return 301 /downloads/; }
location = /downloads/index.php {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /var/www/site/downloads/index.php;
    fastcgi_param SCRIPT_NAME /downloads/index.php;
    fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    client_max_body_size 210M;
    fastcgi_read_timeout 900s;
}
location ^~ /downloads/ {
    client_max_body_size 210M;
    location ~ ^/downloads/assets/[a-zA-Z0-9_/-]+\.(?:css|js|png|jpe?g|webp|gif|svg|ico|woff2?)$ {
        root /var/www/site;
        try_files $uri =404;
        expires 7d;
    }
    location ~ ^/downloads/(?:app|deploy|tests)(?:/|$) { return 403; }
    location ~ ^/downloads/(?:\.|.*/\.) { return 403; }
    location ~ ^/downloads/.*\.(?:php|json|ini|md|txt|lock|bak|log|sql)$ { return 403; }
    try_files "" /downloads/index.php?$query_string;
}
# Optional X-Accel-Redirect: set download_backend=x-accel and map
# '/mnt/ssd/photos/downloads' => '/_gallery_files/' in config.local.php.
# Repeat with a distinct internal URI for every configured photo disk.
location ^~ /_gallery_files/ {
    internal;
    alias /mnt/ssd/photos/downloads/;
    add_header Cache-Control "private, no-store" always;
    add_header X-Content-Type-Options nosniff always;
}
